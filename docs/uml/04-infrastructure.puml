@startuml 04-infrastructure
' ============================================================
' P39 Sports League Management
' Runtime environments, as implemented (2026-11-19)
' ============================================================

!theme plain
skinparam linetype ortho
skinparam defaultFontSize 12
skinparam componentBorderColor #2d5f8a
skinparam componentBackgroundColor #f0f4fa
skinparam databaseBorderColor #2d5f8a
skinparam databaseBackgroundColor #fff4e6
skinparam nodeBorderColor #666666
skinparam nodeBackgroundColor #fafafa
skinparam ArrowColor #2d5f8a
skinparam ArrowThickness 1.5

title Runtime environments — dev, test, production

actor "Browser\n(ADMIN / OFFICIAL / VIEWER)" as USER
cloud "Google Gemini API\n(gemini-3.5-flash)" as GEMINI

' ------------------------------------------------------------
node "Production — Render (Docker, free plan)\nSPRING_PROFILES_ACTIVE=prod" #fdeaea {
    component "Spring Boot 4.1.1 / Java 25\nnon-root eclipse-temurin:25-jre-alpine\n/actuator/health public, everything else needs login" as APP_PROD
    component "HikariCP\nmax 5 / min idle 2" as HIKARI_PROD
    component "Quartz (JDBC job store, clustered)\nRoundLifecycleJob every 5 min\nOverdueFixtureJob hourly" as QUARTZ_PROD
    component "AI port: ChroniclePort\nGeminiChronicleAdapter\n+ ChronicleValidator\n+ AiCallLimiter (30/h)" as AI_PROD
    database "Neon PostgreSQL 17\n(SPRING_DATASOURCE_* from the dashboard)" as PG_PROD

    APP_PROD -down-> HIKARI_PROD
    HIKARI_PROD -down-> PG_PROD : JDBC over TLS
    APP_PROD -right-> QUARTZ_PROD
    QUARTZ_PROD -down-> PG_PROD : qrtz_* tables (V11)
    APP_PROD -right-> AI_PROD
}

USER -down-> APP_PROD : HTTPS (TLS ends at Render)\nsession cookie: Secure, HttpOnly, SameSite=Lax
AI_PROD -up-> GEMINI : HTTPS, 60 s timeout, 1 attempt

' ------------------------------------------------------------
node "Development — laptop" #eaf5ea {
    component "mvnw spring-boot:run\nor docker compose up --build\nprofile: dev, secrets from .env" as APP_DEV
    database "PostgreSQL 17\npostgres:17-alpine\n127.0.0.1:5432 only" as PG_DEV
    APP_DEV -down-> PG_DEV : Flyway V1..V11, ddl-auto=validate
}

' ------------------------------------------------------------
node "Tests / CI — GitHub Actions" #e8f0f8 {
    component "mvnw verify\nprofile: test, JUnit 6 + Mockito\nAI stub: always throws" as APP_TEST
    database "H2 in-memory\nMODE=PostgreSQL" as H2_TEST
    component "mvnw verify -Pintegration\nTestcontainers" as APP_IT
    database "PostgreSQL 17\ncontainer" as PG_IT
    APP_TEST -down-> H2_TEST
    APP_IT -down-> PG_IT
}

note as FW_NOTE
    **Flyway chain (single source of schema)**
    V1 schema (8 tables)   V2 seed (league, 4 teams, season)
    V3 users and roles     V4 switch-user role (removed by V7)
    V5 team sport type     V6 match_chronicles
    V7 remove preview accounts
    V8 players             V9 lineups
    V10 squads seed        V11 Quartz tables
end note

note as TEST_NOTE
    **Test suite: 633 tests, 0 failures**
    JaCoCo gate on application.service
    Integration profile: 4 tests on real PostgreSQL
end note

@enduml
