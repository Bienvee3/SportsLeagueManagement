# Copy to .env (untracked) and export before starting the application.
# Bootstrap ADMIN user created at startup when absent.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# OFFICIAL user (score entry, match events) and VIEWER user (read-only) created at startup when absent.
OFFICIAL_USERNAME=official
OFFICIAL_PASSWORD=change-me-to-a-strong-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-to-a-strong-password

# Production datasource (spring.profiles.active=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sports_league_db
SPRING_DATASOURCE_USERNAME=league_admin
SPRING_DATASOURCE_PASSWORD=change-me

# Gemini AI (Google AI Studio — https://aistudio.google.com/app/apikey)
# Required in dev/prod to enable real chronicle generation.
# When absent, the stub adapter is used (always active in tests).
GEMINI_API_KEY=your-google-ai-studio-api-key-here
